NEXDESK_HOST=desk.example.test
NEXDESK_HTTPS_BIND=0.0.0.0
# For a custom external HTTPS port, include it in the public origin too.
NEXDESK_HTTPS_PORT=443
# NEXDESK_SIGNAL_ORIGIN=https://desk.example.test:9443
# Use a public DNS name on HTTPS port 443 for Caddy's public certificate.
# NEXDESK_CADDYFILE=./Caddyfile.public
NEXDESK_ENROLLMENT_KEY=
NEXDESK_STUN_URLS=
NEXDESK_TURN_URLS=
NEXDESK_TURN_SECRET=
NEXDESK_TURN_BIND_IP=
NEXDESK_TURN_EXTERNAL_IP=
NEXDESK_ICE_RELAY_ONLY=0
