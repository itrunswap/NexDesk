map $http_upgrade $nexdesk_connection {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name desk.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/nexdesk-acme;
        try_files $uri =404;
    }

    location / {
        return 308 https://desk.example.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name desk.example.com;

    ssl_certificate /etc/letsencrypt/live/desk.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/desk.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:54000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $nexdesk_connection;
        proxy_set_header X-NexDesk-Source $remote_addr;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
